# Hub environment — copy to .env next to docker-compose.yml
DATABASE_URL=postgres://user:pass@host:5432/surveillance
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=surveillance
R2_PREFIX=surveillance
TAILSCALE_SOCKET=/run/tailscale/tailscaled.sock
CAMERAS=home-a:home-a.tailnet-name.ts.net,home-b:home-b.tailnet-name.ts.net
# Optional alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
